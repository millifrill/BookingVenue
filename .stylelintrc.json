{
   "extends": "stylelint-config-standard",
   "rules": {
      "selector-class-pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "selector-id-pattern": "^[a-z][a-zA-Z0-9]*$",
      "declaration-property-unit-allowed-list": {
         "font-size": ["rem"],
         "height": ["px", "vh", "vw", "%"],
         "width": ["px", "vh", "vw", "%"]
      }
   }
}
